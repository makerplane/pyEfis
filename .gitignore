.~lock*
*.ods
*.log
.DS_Store
*.pyc
pyEfisSudo.txt
*~
doc/_*
.ropeproject/*
.directory
# Anchored to the repo root: ignore a runtime ./config/, NOT the tracked
# package config under src/pyefis/config/ (so new button/screen yaml is tracked
# normally without git add -f).
/config/

# IDE artifacts
.vscode/
.code-worksapce

### Python template
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Binary stuff
*.png
*.jpg
# ...except the golden regression images (see docs/svs_structural_plan.md P0)
!tests/golden/*.png

# C extensions
*.so

# Virtual environments
env/
venv/
.venv/
ENV/
.env

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

*.log

# Sphinx documentation
docs/_build/

# Makefile markers
*.marker

# Bulk FAA data drops (CIFP, NASR, DOF). Users download these locally;
# build tools turn them into sqlite files (also kept out of the repo).
cifp/
nasr/
dof/

# Reproducible screenshot-harness output (regenerate with GENERATE_SCREENSHOTS=1)
docs/images/generated/
.gstack/
